<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>A Special Surprise For Aaron ❤️</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
        }

        body, html {
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            background-color: #111;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Segoe UI', Arial, sans-serif;
        }

        .app-viewport {
            position: relative;
            width: 100vw;
            height: 100vh;
            max-width: 1200px;
            max-height: 675px;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            overflow: hidden;
        }

        .page {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: none;
            background-size: contain;
            background-position: center;
            background-repeat: no-repeat;
        }

        .page.active {
            display: block;
        }

        /* SAĞ ALT GEÇİŞ / ÇIKIŞ BUTONLARI */
        .next-btn {
            position: absolute;
            bottom: 4%;
            right: 4%;
            width: 70px;
            height: 70px;
            border-radius: 50%;
            cursor: pointer;
            z-index: 50;
            background: rgba(255, 255, 255, 0.01);
        }

        /* 1. SAYFA: KİLİT EKRANI */
        #page1 { background-image: url('1-kilit.png'); }

        .heart-slots {
            position: absolute;
            top: 35.5%;
            right: 9.5%;
            width: 325px;
            height: 70px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 10;
        }

        .heart-slot {
            width: 70px;
            height: 70px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 28px;
            font-weight: bold;
            color: #ffffff;
            text-shadow: 1px 2px 4px rgba(0,0,0,0.3);
        }

        .keypad {
            position: absolute;
            right: 9.5%;
            top: 48.5%;
            width: 325px;
            height: 280px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            z-index: 10;
        }

        .key-btn {
            background: transparent;
            border: none;
            border-radius: 12px;
            cursor: pointer;
        }

        .key-btn:active {
            background: rgba(255, 255, 255, 0.2);
        }

        /* 2. SAYFA: KUTULAR */
        #page2 { background-image: url('2-kutular.png'); }

        .gifts-container {
            position: absolute;
            bottom: 12%;
            left: 8%;
            width: 84%;
            height: 200px;
            display: flex;
            justify-content: space-between;
            z-index: 10;
        }

        .gift-item {
            width: 22%;
            height: 100%;
            cursor: pointer;
        }

        /* 3. SAYFA: DRAGON BALL */
        #page3 { background-image: url('3-dragonball.png'); }

        /* 4. SAYFA: MEKTUP */
        #page4 { background-image: url('4-mektup.png'); }

        /* 5. SAYFA: PLAYLIST & PLAK */
        #page5 { background-image: url('5-playlist.png'); }

        .vinyl-clickable {
            position: absolute;
            right: 20.8%;
            top: 26.5%;
            width: 285px;
            height: 285px;
            border-radius: 50%;
            cursor: pointer;
            z-index: 20;
            transition: transform 0.3s ease;
        }

        .spinning {
            animation: spinVinyl 3s linear infinite;
        }

        @keyframes spinVinyl {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        /* 6. SAYFA: OYUN */
        #page6 { background-image: url('6-oyun.png'); }

        .score-board {
            position: absolute;
            top: 31%;
            left: 55.5%;
            transform: translateX(-50%);
            font-size: 20px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: 2px;
            z-index: 25;
            text-shadow: 1px 1px 3px rgba(0,0,0,0.5);
        }

        .game-area {
            position: absolute;
            top: 37%;
            left: 36.5%;
            width: 38%;
            height: 48%;
            overflow: hidden;
            z-index: 20;
        }

        .floating-heart {
            position: absolute;
            font-size: 32px;
            cursor: pointer;
            animation: floatAnim 3s infinite alternate ease-in-out;
        }

        @keyframes floatAnim {
            0% { transform: translateY(0px) scale(1); }
            100% { transform: translateY(-15px) scale(1.1); }
        }

        /* MODAL (HEDİYE MESAJLARI) */
        .modal {
            display: none;
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.6);
            z-index: 100;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background: #fff;
            padding: 30px;
            border-radius: 20px;
            max-width: 380px;
            text-align: center;
            position: relative;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        .close-btn {
            position: absolute;
            top: 10px; right: 15px;
            font-size: 24px; font-weight: bold;
            color: #d81b60; cursor: pointer;
        }
    </style>
</head>
<body>

    <div class="app-viewport">

        <!-- 1. SAYFA: KİLİT EKRANI -->
        <div class="page active" id="page1">
            <div class="heart-slots">
                <div class="heart-slot" id="slot0"></div>
                <div class="heart-slot" id="slot1"></div>
                <div class="heart-slot" id="slot2"></div>
                <div class="heart-slot" id="slot3"></div>
            </div>
            <div class="keypad">
                <button class="key-btn" onclick="pressKey('1')"></button>
                <button class="key-btn" onclick="pressKey('2')"></button>
                <button class="key-btn" onclick="pressKey('3')"></button>
                <button class="key-btn" onclick="pressKey('4')"></button>
                <button class="key-btn" onclick="pressKey('5')"></button>
                <button class="key-btn" onclick="pressKey('6')"></button>
                <button class="key-btn" onclick="pressKey('7')"></button>
                <button class="key-btn" onclick="pressKey('8')"></button>
                <button class="key-btn" onclick="pressKey('9')"></button>
                <button class="key-btn" onclick="clearCode()"></button>
                <button class="key-btn" onclick="pressKey('0')"></button>
                <button class="key-btn" onclick="submitCode()"></button>
            </div>
        </div>

        <!-- 2. SAYFA: HEDİYE KUTULARI -->
        <div class="page" id="page2">
            <div class="gifts-container">
                <div class="gift-item" onclick="openGift(1)"></div>
                <div class="gift-item" onclick="openGift(2)"></div>
                <div class="gift-item" onclick="openGift(3)"></div>
                <div class="gift-item" onclick="openGift(4)"></div>
            </div>
            <div class="next-btn" onclick="goToPage(3)"></div>
        </div>

        <!-- 3. SAYFA: DRAGON BALL -->
        <div class="page" id="page3">
            <div class="next-btn" onclick="goToPage(4)"></div>
        </div>

        <!-- 4. SAYFA: MEKTUP -->
        <div class="page" id="page4">
            <div class="next-btn" onclick="goToPage(5)"></div>
        </div>

        <!-- 5. SAYFA: PLAYLIST (PLAK) -->
        <div class="page" id="page5">
            <div class="vinyl-clickable" id="vinylDisk" onclick="toggleMusic()"></div>
            <div class="next-btn" onclick="goToPage(6)"></div>
        </div>

        <!-- 6. SAYFA: KALP OYUNU -->
        <div class="page" id="page6">
            <div class="score-board" id="scoreBoard">SCORE: 0 / 7</div>
            <div class="game-area" id="gameArea"></div>
            <!-- ÇIKIŞ / EN BAŞA DÖNÜŞ (SAĞ ALTTA) -->
            <div class="next-btn" onclick="goToPage(1)"></div>
        </div>

        <!-- HEDİYE PENCERESİ (MODAL) -->
        <div class="modal" id="giftModal">
            <div class="modal-content">
                <span class="close-btn" onclick="closeGift()">&times;</span>
                <h3 id="modalTitle" style="color:#d81b60; margin-bottom:12px;">Sürpriz!</h3>
                <p id="modalText" style="color:#444; font-size: 16px; line-height: 1.4;"></p>
            </div>
        </div>

    </div>

    <!-- MÜZİK DOSYASI -->
    <audio id="bgMusic" loop>
        <source src="lovesong.mp3" type="audio/mpeg">
    </audio>

    <script>
        let enteredCode = "";
        const correctCode = "0807";
        let isPlaying = false;
        let score = 0;

        function goToPage(pageNum) {
            document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
            document.getElementById('page' + pageNum).classList.add('active');
            
            if(pageNum === 6) {
                startGame();
            }
        }

        /* 1. SAYFA KİLİT MANTIĞI: RAKAMLAR KALPLERİN İÇİNE YAZILIR */
        function pressKey(digit) {
            if (enteredCode.length < 4) {
                enteredCode += digit;
                updateHeartSlots();
            }
        }

        function clearCode() {
            enteredCode = "";
            updateHeartSlots();
        }

        function updateHeartSlots() {
            for (let i = 0; i < 4; i++) {
                const slot = document.getElementById('slot' + i);
                if (i < enteredCode.length) {
                    slot.innerText = enteredCode[i];
                } else {
                    slot.innerText = "";
                }
            }
        }

        function submitCode() {
            if (enteredCode === correctCode) {
                goToPage(2);
            } else {
                alert("Incorrect PIN! ❤️");
                clearCode();
            }
        }

        /* 2. SAYFA HEDİYE MESAJLARI */
        const gifts = {
            1: "Je t'aime de tout mon cœur! ❤️",
            2: "You are my absolute favorite person in the entire world! ✨",
            3: "Every moment spent with you is a gift! 🤗",
            4: "Forever and always yours! 💖"
        };

        function openGift(id) {
            document.getElementById('modalTitle').innerText = "Surprise #" + id;
            document.getElementById('modalText').innerText = gifts[id];
            document.getElementById('giftModal').style.display = 'flex';
        }

        function closeGift() {
            document.getElementById('giftModal').style.display = 'none';
        }

        /* 5. SAYFA PLAK MÜZİK ÇALAR MANTIĞI */
        function toggleMusic() {
            const music = document.getElementById('bgMusic');
            const disk = document.getElementById('vinylDisk');

            if (!isPlaying) {
                music.play().then(() => {
                    isPlaying = true;
                    disk.classList.add('spinning');
                }).catch(err => alert("Lütfen ekrana dokunup tekrar deneyin."));
            } else {
                music.pause();
                isPlaying = false;
                disk.classList.remove('spinning');
            }
        }

        /* 6. SAYFA OYUN MANTIĞI */
        function startGame() {
            score = 0;
            updateScore();
            const gameArea = document.getElementById('gameArea');
            gameArea.innerHTML = "";

            for (let i = 0; i < 7; i++) {
                const heart = document.createElement('div');
                heart.className = 'floating-heart';
                heart.innerText = '💖';
                heart.style.left = Math.random() * 80 + '%';
                heart.style.top = Math.random() * 75 + '%';

                heart.onclick = function() {
                    this.remove();
                    score++;
                    updateScore();
                    if (score >= 7) {
                        alert("You collected all hearts! I Love You Aaron! ❤️");
                    }
                };
                gameArea.appendChild(heart);
            }
        }

        function updateScore() {
            document.getElementById('scoreBoard').innerText = `SCORE: ${score} / 7`;
        }
    </script>
</body>
</html>
